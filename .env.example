# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for sitemap, Open Graph, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (Settings > Developer settings > OAuth Apps)
# Callback URL: <site url>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Only this GitHub username can sign in to /admin
ADMIN_GITHUB_LOGIN=

# Optional: one-click "Dev login" button on /admin/login. Only works with `next dev`.
AUTH_DEV_LOGIN=false

# Optional: Cloudinary for image / resume uploads. Without it, paste image URLs instead.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: email notifications for new contact messages (https://resend.com)
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=Portfolio <onboarding@resend.dev>

# Optional: Umami analytics (https://cloud.umami.is or self-hosted). Only loads in production
# and only counts visits on the NEXT_PUBLIC_SITE_URL domain.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
